<%- include('layout/header', { title: 'Doações - RedeVita', extra_css: '/static/css/inventory.css' }) %>
<%- include('layout/nav') %>

<div class="page-wrapper">
    <div class="page-header">
        <div>
            <h2><i class="ph-duotone ph-hand-heart"></i> Gestão e Triagem de Doações</h2>
            <p class="page-subtitle">Acompanhe doações de medicamentos e o processo de triagem farmacêutica.</p>
        </div>
        <div>
            <button class="btn-primary" onclick="abrirModal('modal-doacao')">
                <i class="ph-duotone ph-plus-circle"></i> Registrar Doação
            </button>
        </div>
    </div>

    <div class="table-toolbar" role="search" style="margin-top:16px;">
        <div class="search-input-wrapper relative" style="position: relative; display: flex; align-items: center; width: 100%; max-width: 380px;">
            <i class="ph-duotone ph-magnifying-glass" aria-hidden="true" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; z-index: 10; color: #64748b; font-size: 1rem;"></i>
            <input type="search" id="doacoes-table-search"
                   data-table-search="tabela-doacoes"
                   placeholder="Buscar por doador, medicamento ou responsável..."
                   autocomplete="off"
                   style="width: 100%; padding-left: 44px !important;">
        </div>
        <span class="table-search-hint" style="font-size:0.85rem; color:var(--text-muted);"></span>
    </div>

    <div class="table-wrapper" style="margin-top:10px;">
        <table class="styled-table" id="tabela-doacoes">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Doador</th>
                    <th>Medicamento</th>
                    <th>Qtd.</th>
                    <th>Data</th>
                    <th>Responsável</th>
                    <th>Observações</th>
                    <th style="text-align:center;">Triagem</th>
                </tr>
            </thead>
            <tbody>
                <% doacoes.forEach(function(d) { %>
                <tr>
                    <td>
                        <% if (d.status === 'Aprovada') { %>
                            <span class="status-pill green"><i class="ph-duotone ph-check-circle"></i> Aprovada</span>
                        <% } else if (d.status === 'Recusada') { %>
                            <span class="status-pill red"><i class="ph-duotone ph-x-circle"></i> Recusada</span>
                        <% } else if (d.status === 'Em Triagem') { %>
                            <span class="status-pill yellow"><i class="ph-duotone ph-clock"></i> Em Triagem</span>
                        <% } else { %>
                            <span class="status-pill" style="background:#3b82f6; color:#fff;"><i class="ph-duotone ph-hourglass-simple"></i> Pendente</span>
                        <% } %>
                    </td>
                    <td><strong><%= d.doador %></strong></td>
                    <td><%= d.medicamento %></td>
                    <td><%= d.quantidade %> un.</td>
                    <td><%= d.data_doacao %></td>
                    <td><%= d.responsavel || '—' %></td>
                    <td><small style="color:var(--text-muted);"><%= d.observacoes || 'Sem observações' %></small></td>
                    <td style="text-align:center;">
                        <% if (d.status !== 'Aprovada' && d.status !== 'Recusada') { %>
                        <div style="display:inline-flex; gap:6px;">
                            <form action="/doacoes/<%= d.id %>/triagem" method="POST" style="display:inline;">
                                <input type="hidden" name="status" value="Aprovada">
                                <button type="submit" class="btn-icon" style="color:#2ecc71;" title="Aprovar doação">
                                    <i class="ph-duotone ph-check"></i>
                                </button>
                            </form>
                            <form action="/doacoes/<%= d.id %>/triagem" method="POST" style="display:inline;">
                                <input type="hidden" name="status" value="Recusada">
                                <button type="submit" class="btn-icon" style="color:#e74c3c;" title="Recusar doação">
                                    <i class="ph-duotone ph-x"></i>
                                </button>
                            </form>
                        </div>
                        <% } else { %>
                            <span style="font-size:0.8rem; color:var(--text-muted);">Concluída</span>
                        <% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nova Doação -->
<div id="modal-doacao" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-header">
            <h3><i class="ph-duotone ph-hand-heart"></i> Nova Doação</h3>
            <button type="button" class="modal-close" onclick="fecharModal('modal-doacao')">&times;</button>
        </div>
        <form action="/doacoes" method="POST" class="modern-form" style="padding:20px;">
            <div class="form-group" style="margin-bottom:12px;">
                <label for="doador">Nome do Doador / Instituição *</label>
                <input type="text" id="doador" name="doador" required placeholder="Ex: Maria Helena Costa" class="input-standard">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
                <label for="doacao_med">Medicamento Doado *</label>
                <input type="text" id="doacao_med" name="medicamento" required placeholder="Ex: Losartana 50mg" class="input-standard">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
                <label for="doacao_qtd">Quantidade *</label>
                <input type="number" id="doacao_qtd" name="quantidade" min="1" required placeholder="Ex: 20" class="input-standard">
            </div>
            <div class="form-group" style="margin-bottom:16px;">
                <label for="doacao_obs">Observações / Estado da Embalagem</label>
                <textarea id="doacao_obs" name="observacoes" rows="3" placeholder="Lacre íntegro, caixa lacrada..." class="input-standard"></textarea>
            </div>
            <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="btn-secondary" onclick="fecharModal('modal-doacao')">Cancelar</button>
                <button type="submit" class="btn-primary"><i class="ph-duotone ph-floppy-disk"></i> Registrar Doação</button>
            </div>
        </form>
    </div>
</div>

<%- include('layout/footer') %>
