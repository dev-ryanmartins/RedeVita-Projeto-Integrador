# Ambiente de teste descartável para P0.10/P0.11
# Não usar em produção

SECRET_KEY=test-secret-key-for-testing-only
SESSION_SECRET=test-session-secret-for-testing-only
JWT_SECRET_KEY=test-jwt-secret-for-testing-only

# Banco de dados SQLite descartável
SQLALCHEMY_DATABASE_URI=sqlite:///test_redevita.db

# Configurações de e-mail (desativado para teste)
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=

# Configurações de integrações externas (desativadas para teste)
ANVISA_API_URL=
ANVISA_API_KEY=
VIA_CEP_API_URL=

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=1
APP_HOST=127.0.0.1
PORT=5000
OPEN_BROWSER=false

# QR expiration (minutos)
QR_EXPIRATION_MINUTES=15
