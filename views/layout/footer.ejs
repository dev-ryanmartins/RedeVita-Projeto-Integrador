</main>

<div id="global-confirm-modal" class="modal-overlay" style="display:none;" aria-hidden="true">
    <div class="modal-box modal-sm confirm-modal" role="dialog" aria-modal="true">
        <div class="modal-header">
            <h3><i class="ph-duotone ph-warning"></i> Confirmar ação</h3>
            <button type="button" class="modal-close" onclick="fecharModal('global-confirm-modal')">&times;</button>
        </div>
        <p id="global-confirm-message" class="confirm-modal-message" style="padding:15px;"></p>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" onclick="fecharModal('global-confirm-modal')">Cancelar</button>
            <button type="button" class="btn-danger" id="global-confirm-submit">
                <i class="ph-duotone ph-check"></i> Confirmar
            </button>
        </div>
    </div>
</div>

<script src="/static/js/mascaras.js"></script>
<script>
    // Mobile navigation toggle
    const navToggle = document.getElementById('navToggle');
    const navLinks = document.getElementById('navLinks');
    if (navToggle && navLinks) {
        navToggle.addEventListener('click', () => {
            const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
            navToggle.setAttribute('aria-expanded', !isExpanded);
            navLinks.classList.toggle('open');
        });
    }

    // Modal helpers
    function abrirModal(id) {
        const m = document.getElementById(id);
        if (m) {
            m.style.display = 'flex';
            m.setAttribute('aria-hidden', 'false');
        }
    }

    function fecharModal(id) {
        const m = document.getElementById(id);
        if (m) {
            m.style.display = 'none';
            m.setAttribute('aria-hidden', 'true');
        }
    }

    // Close modal on click outside box
    window.addEventListener('click', (e) => {
        if (e.target.classList.contains('modal-overlay')) {
            e.target.style.display = 'none';
            e.target.setAttribute('aria-hidden', 'true');
        }
    });
</script>
<script src="/static/js/redevita-enhancements.js"></script>
<% if (typeof extra_js !== 'undefined' && extra_js) { %>
    <script src="<%= extra_js %>"></script>
<% } %>
</body>
</html>
