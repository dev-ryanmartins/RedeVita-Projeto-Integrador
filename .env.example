PORT=5000
FLASK_ENV=development
FLASK_DEBUG=true

# Session secret for web application (required in production, min 32 chars)
SESSION_SECRET=

# JWT secret for API authentication (required in production, min 32 chars, must differ from SESSION_SECRET)
JWT_SECRET_KEY=

# Alternative: can use SECRET_KEY for both (not recommended for production)
# SECRET_KEY=

DATABASE_URL=

# Optional: Email configuration for password recovery
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=RedeVita <nao-responda@redevita.com>

# Optional: Twilio for SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Session cookie security (automatically true in production)
SESSION_COOKIE_SECURE=false

# Optional: JWT expiration in seconds
JWT_EXPIRATION=3600

# Optional: QR Code expiration time in minutes (default 15)
QR_EXPIRATION_MINUTES=15

# External API tokens
ANVISA_API_TOKEN=
GOOGLE_MAPS_API_KEY=