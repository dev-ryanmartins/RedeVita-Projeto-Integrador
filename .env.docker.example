# Variáveis de ambiente para Docker Compose.
# Copie este arquivo para .env e preencha com valores seguros.
# Nunca comite o arquivo .env com valores reais.

# --- Banco de dados MySQL ---------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=redevita
MYSQL_USER=
MYSQL_PASSWORD=

# URL de conexão usada pela aplicação
# Formato: mysql+pymysql://MYSQL_USER:MYSQL_PASSWORD@db:3306/MYSQL_DATABASE
DATABASE_URL=

# --- Segurança --------------------------------------------------------------
# Chave principal (>= 32 caracteres). SESSION_SECRET e JWT_SECRET_KEY
# herdam/derivam automaticamente desta chave.
SECRET_KEY=

# --- Ambiente ---------------------------------------------------------------
FLASK_ENV=production

# --- Integração externa - ViaCEP (API pública de CEP) -----------------------
VIA_CEP_API_URL=https://viacep.com.br/ws/

# --- SMTP - Mailtrap Sandbox (opcional) ------------------------------------
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=RedeVita <noreply@redevita.com>

# Instruções:
# 1. Gere valores fortes para MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD e SECRET_KEY
# 2. Configure DATABASE_URL com as credenciais definidas acima
# 3. Execute: docker-compose up -d
# 4. Para desenvolvimento local, a porta 3306 do MySQL fica acessível apenas em localhost (127.0.0.1)
