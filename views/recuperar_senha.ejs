<%- include('layout/header', { title: 'Recuperar Senha - RedeVita', extra_css: '/static/css/login.css' }) %>

<div class="auth-wrapper">
    <div class="auth-card-modern">
        <div class="auth-brand-center">
            <a href="/login" class="redevita-brand" aria-label="RedeVita" style="display:inline-flex; align-items:center; text-decoration:none; margin-bottom:14px;">
                <span class="redevita-logo-icon" aria-hidden="true" style="margin-right:6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 72 56" style="height:38px; width:auto;">
                        <defs>
                            <style>
                                .cruz-borda { fill: none; stroke: #0ea5e9; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }
                                .coracao-vermelho { fill: #f43f5e; }
                                .ecg-linha { fill: none; stroke: #ffffff; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
                            </style>
                        </defs>
                        <path class="cruz-borda" d="M 27 5 h 12 a 4 4 0 0 1 4 4 v 11 h 11 a 4 4 0 0 1 4 4 v 10 a 4 4 0 0 1 -4 4 h -11 v 11 a 4 4 0 0 1 -4 4 h -12 a 4 4 0 0 1 -4 -4 v -11 h -11 a 4 4 0 0 1 -4 -4 v -10 a 4 4 0 0 1 4 -4 h 11 v -11 a 4 4 0 0 1 4 -4 z" />
                        <path class="coracao-vermelho" transform="translate(1, -4) scale(1.5)" d="M 40 20 C 40 13 31 11 27 17 C 23 11 14 13 14 20 C 14 29 27 37 27 37 C 27 37 40 29 40 20 Z" />
                        <path class="ecg-linha" d="M 21 25 h 5 l 3.5 -11 l 5 22 l 4.5 -14 l 3.5 3 h 6" />
                    </svg>
                </span>
                <span class="redevita-brand-text">
                    <span class="brand-rede" style="color:#ffffff; font-weight:800; font-size:1.55rem;">Rede</span><span class="brand-vita" style="color:#38bdf8; font-weight:800; font-size:1.55rem;">Vita</span>
                </span>
            </a>
            <h2>Recuperar Senha</h2>
            <p class="subtitle">Informe seu CPF cadastrado para receber um código de segurança de 6 dígitos.</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" style="margin-bottom:20px; display:flex; align-items:center; justify-content:center; gap:8px; text-align:center;">
                <i class="ph-duotone ph-warning-circle" style="font-size:1.2rem;"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (typeof info !== 'undefined' && info) { %>
            <div class="alert alert-info" style="margin-bottom:20px; display:flex; align-items:center; justify-content:center; gap:8px; text-align:center;">
                <i class="ph-duotone ph-info" style="font-size:1.2rem;"></i>
                <span><%= info %></span>
            </div>
        <% } %>

        <form action="/recuperar-senha" method="POST" class="modern-form" id="form-recuperar">
            <div class="form-group" style="margin-bottom:24px; text-align:center;">
                <label for="identificador" style="color:#cbd5e1; font-weight:600; margin-bottom:8px; display:block; text-align:center;">
                    CPF Cadastrado <span style="color:#f43f5e;">*</span>
                </label>
                <div class="input-with-icon">
                    <i class="ph-duotone ph-identification-card"></i>
                    <input type="text" name="identificador" id="identificador"
                           placeholder="000.000.000-00" maxlength="14" inputmode="numeric" required
                           autocomplete="off" autofocus
                           value="<%= typeof identificador !== 'undefined' ? identificador : '' %>">
                </div>
                <small style="color:#64748b; font-size:0.82rem; margin-top:8px; display:block; text-align:center; line-height:1.4;">
                    Enviaremos um código numérico de 6 dígitos com validade de 15 minutos.
                </small>
            </div>

            <button type="submit" class="btn-primary-gradient" style="width:100%; display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:14px; font-weight:600;">
                <span>Enviar Código de Verificação</span>
                <i class="ph-duotone ph-paper-plane-tilt"></i>
            </button>
        </form>

        <div style="margin-top: 28px; text-align: center; border-top: 1px solid rgba(255, 255, 255, 0.06); padding-top: 20px; display: flex; justify-content: center; width: 100%;">
            <a href="/login" class="auth-back-link" style="justify-content: center; width: auto;">
                <i class="ph-duotone ph-arrow-left"></i>
                <span>Voltar para o Login</span>
            </a>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const inputCpf = document.getElementById('identificador');
        if (inputCpf) {
            inputCpf.addEventListener('input', function(e) {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length > 11) value = value.slice(0, 11);
                if (value.length > 9) {
                    value = value.replace(/^(\d{3})(\d{3})(\d{3})(\d{1,2})$/, '$1.$2.$3-$4');
                } else if (value.length > 6) {
                    value = value.replace(/^(\d{3})(\d{3})(\d{1,3})$/, '$1.$2.$3');
                } else if (value.length > 3) {
                    value = value.replace(/^(\d{3})(\d{1,3})$/, '$1.$2');
                }
                e.target.value = value;
            });
        }
    });
</script>

<%- include('layout/footer') %>
