PORT=5000
SECRET_KEY=
SESSION_SECRET=
JWT_SECRET_KEY=
JWT_EXPIRATION=3600
FLASK_ENV=production
DATABASE_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=redevita
MYSQL_USER=
MYSQL_PASSWORD=
ANVISA_API_TOKEN=
GOOGLE_MAPS_API_KEY=

# Integração externa - ViaCEP (API pública de CEP)
VIA_CEP_API_URL=https://viacep.com.br/ws/

# SMTP - Mailtrap Sandbox (padrão em produção)
# Em desenvolvimento/teste o padrão é o servidor SMTP local de depuração (localhost:1025).
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=RedeVita <noreply@redevita.com>

# Cache
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300
