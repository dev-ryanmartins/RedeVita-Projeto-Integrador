<%- include('layout/header', { title: 'Inventário - RedeVita', extra_css: '/static/css/inventory.css' }) %>
<%- include('layout/nav') %>

<div class="page-wrapper">
    <div class="page-header">
        <div>
            <h2><i class="ph-duotone ph-pill"></i> Inventário de Medicamentos</h2>
            <p class="page-subtitle">Gerencie o estoque de medicamentos cadastrados.</p>
        </div>
        <div style="display:flex; gap:10px;">
            <button type="button" class="btn-secondary" onclick="window.print()" title="Imprimir inventário limpo ou salvar em PDF">
                <i class="ph-duotone ph-printer"></i> Imprimir / PDF
            </button>
            <a href="/inventario/exportar-csv" class="btn-secondary" style="justify-content:center;">
                <i class="ph-duotone ph-file-csv"></i> CSV
            </a>
            <button class="btn-primary" onclick="abrirModal('modal-add')">
                <i class="ph-duotone ph-plus-circle"></i> Novo Medicamento
            </button>
        </div>
    </div>

    <div class="table-toolbar" role="search" style="margin-bottom:16px;">
        <label class="table-search" for="inventory-table-search">
            <i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
            <input type="search" id="inventory-table-search"
                   placeholder="Buscar medicamento, lote ou princípio ativo..."
                   oninput="filtrarTabela()" onkeyup="filtrarTabela()" autocomplete="off">
        </label>
        <span id="inventory-search-hint" class="table-search-hint" style="font-size:0.85rem; color:var(--text-muted);"></span>
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <label style="font-size:0.85rem; color:var(--text-muted);">Filtro Tarja:</label>
            <div class="filter-chips" id="filtro-tarja-chips">
                <button type="button" class="filter-chip active" onclick="filtrarTarja('', this)">Todos</button>
                <button type="button" class="filter-chip" onclick="filtrarTarja('Sem Tarja', this)">Sem Tarja</button>
                <button type="button" class="filter-chip" onclick="filtrarTarja('Tarja Amarela', this)">Amarela</button>
                <button type="button" class="filter-chip" onclick="filtrarTarja('Tarja Vermelha', this)">Vermelha</button>
                <button type="button" class="filter-chip" onclick="filtrarTarja('Portaria 344', this)">Portaria 344</button>
            </div>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="styled-table" id="inventory-table">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Medicamento</th>
                    <th>Lote</th>
                    <th>Validade</th>
                    <th>Qtd.</th>
                    <th>Tarja</th>
                    <th style="text-align:center;">Ações</th>
                </tr>
            </thead>
            <tbody id="inventory-tbody">
                <% medicamentos.forEach(function(med) { %>
                <tr data-tarja="<%= med.tarja || '' %>">
                    <td>
                        <% if (med.status_semaforo === 0) { %>
                            <span class="status-pill green"><i class="fas fa-circle"></i> Seguro</span>
                        <% } else if (med.status_semaforo === 1) { %>
                            <span class="status-pill yellow"><i class="fas fa-circle"></i> Atenção</span>
                        <% } else { %>
                            <span class="status-pill red"><i class="fas fa-circle"></i> Vencido</span>
                        <% } %>
                    </td>
                    <td>
                        <strong><%= med.nome %></strong>
                        <% if (med.principio_ativo) { %>
                            <br><small style="color:var(--text-muted);"><%= med.principio_ativo %></small>
                        <% } %>
                    </td>
                    <td><code class="lote-code"><%= med.lote %></code></td>
                    <td><%= med.data_validade %></td>
                    <td><strong><%= med.quantidade %></strong> un.</td>
                    <td><%= med.tarja || '—' %></td>
                    <td style="text-align:center;">
                        <div class="action-btns" style="display:inline-flex; gap:6px;">
                            <button type="button" class="btn-icon btn-edit" title="Editar"
                                    onclick="editarMed(<%= JSON.stringify(med) %>)">
                                <i class="fas fa-pen"></i>
                            </button>
                            <form action="/inventario/deletar/<%= med.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Confirma a exclusão de <%= med.nome %>?')">
                                <button type="submit" class="btn-icon btn-delete" title="Excluir">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Adicionar Medicamento -->
<div id="modal-add" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:550px;">
        <div class="modal-header">
            <h3><i class="fas fa-pills"></i> Cadastrar Medicamento</h3>
            <button type="button" class="modal-close" onclick="fecharModal('modal-add')">&times;</button>
        </div>
        <form action="/inventario/adicionar" method="POST" class="modern-form" style="padding:20px;">
            <div class="form-group" style="margin-bottom:12px;">
                <label for="med_nome">Nome Comercial *</label>
                <input type="text" id="med_nome" name="nome" required placeholder="Ex: Dipirona 500mg" class="input-standard">
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:12px;">
                <div class="form-group">
                    <label for="med_lote">Lote *</label>
                    <input type="text" id="med_lote" name="lote" required placeholder="Ex: LOT-2026-A" class="input-standard">
                </div>
                <div class="form-group">
                    <label for="med_validade">Data de Validade *</label>
                    <input type="date" id="med_validade" name="data_validade" required class="input-standard">
                </div>
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:12px;">
                <div class="form-group">
                    <label for="med_qtd">Quantidade *</label>
                    <input type="number" id="med_qtd" name="quantidade" min="0" required placeholder="Ex: 100" class="input-standard">
                </div>
                <div class="form-group">
                    <label for="med_tarja">Tarja</label>
                    <select id="med_tarja" name="tarja" class="input-standard">
                        <option value="Sem Tarja">Sem Tarja</option>
                        <option value="Tarja Amarela">Tarja Amarela</option>
                        <option value="Tarja Vermelha">Tarja Vermelha</option>
                        <option value="Portaria 344">Portaria 344</option>
                    </select>
                </div>
            </div>
            <div class="form-group" style="margin-bottom:16px;">
                <label for="med_principio">Princípio Ativo</label>
                <input type="text" id="med_principio" name="principio_ativo" placeholder="Ex: Dipirona Sódica" class="input-standard">
            </div>
            <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="btn-secondary" onclick="fecharModal('modal-add')">Cancelar</button>
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Salvar Medicamento</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Medicamento -->
<div id="modal-edit" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:550px;">
        <div class="modal-header">
            <h3><i class="fas fa-pen"></i> Editar Medicamento</h3>
            <button type="button" class="modal-close" onclick="fecharModal('modal-edit')">&times;</button>
        </div>
        <form id="form-edit" method="POST" class="modern-form" style="padding:20px;">
            <div class="form-group" style="margin-bottom:12px;">
                <label for="edit_nome">Nome Comercial *</label>
                <input type="text" id="edit_nome" name="nome" required class="input-standard">
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:12px;">
                <div class="form-group">
                    <label for="edit_lote">Lote *</label>
                    <input type="text" id="edit_lote" name="lote" required class="input-standard">
                </div>
                <div class="form-group">
                    <label for="edit_validade">Data de Validade *</label>
                    <input type="date" id="edit_validade" name="data_validade" required class="input-standard">
                </div>
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:12px;">
                <div class="form-group">
                    <label for="edit_qtd">Quantidade *</label>
                    <input type="number" id="edit_qtd" name="quantidade" min="0" required class="input-standard">
                </div>
                <div class="form-group">
                    <label for="edit_tarja">Tarja</label>
                    <select id="edit_tarja" name="tarja" class="input-standard">
                        <option value="Sem Tarja">Sem Tarja</option>
                        <option value="Tarja Amarela">Tarja Amarela</option>
                        <option value="Tarja Vermelha">Tarja Vermelha</option>
                        <option value="Portaria 344">Portaria 344</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="btn-secondary" onclick="fecharModal('modal-edit')">Cancelar</button>
                <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Atualizar</button>
            </div>
        </form>
    </div>
</div>

<script>
    let tarjaAtual = '';

    function filtrarTarja(tarja, btn) {
        tarjaAtual = tarja;
        document.querySelectorAll('#filtro-tarja-chips .filter-chip').forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        filtrarTabela();
    }

    function normalizarBusca(val) {
        return String(val || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .trim();
    }

    function filtrarTabela() {
        const input = document.getElementById('inventory-table-search');
        const query = normalizarBusca(input ? input.value : '');
        const rows = document.querySelectorAll('#inventory-tbody tr:not(.table-search-empty-state)');
        const tbody = document.getElementById('inventory-tbody');
        let visiveis = 0;

        rows.forEach(row => {
            const text = normalizarBusca(row.innerText);
            const rowTarja = row.getAttribute('data-tarja') || '';
            const matchesQuery = !query || text.includes(query);
            const matchesTarja = !tarjaAtual || rowTarja === tarjaAtual;

            const visivel = matchesQuery && matchesTarja;
            row.style.display = visivel ? '' : 'none';
            if (visivel) visiveis++;
        });

        let emptyRow = document.getElementById('inventory-empty-search-row');
        if (visiveis === 0 && rows.length > 0 && (query || tarjaAtual)) {
            if (!emptyRow && tbody) {
                emptyRow = document.createElement('tr');
                emptyRow.id = 'inventory-empty-search-row';
                emptyRow.className = 'table-search-empty-state';
                emptyRow.innerHTML = `
                    <td colspan="7" style="text-align:center; padding:32px 16px; color:var(--text-muted); font-size:0.9rem;">
                        <i class="ph-duotone ph-magnifying-glass" style="font-size:1.8rem; display:block; margin:0 auto 8px auto; opacity:0.6;"></i>
                        Nenhum medicamento encontrado para os critérios selecionados.
                    </td>
                `;
                tbody.appendChild(emptyRow);
            }
            if (emptyRow) emptyRow.style.display = '';
        } else if (emptyRow) {
            emptyRow.style.display = 'none';
        }

        const hint = document.getElementById('inventory-search-hint');
        if (hint) {
            if (query || tarjaAtual) {
                hint.textContent = visiveis === 1 ? '1 medicamento encontrado' : `${visiveis} medicamentos encontrados`;
            } else {
                hint.textContent = '';
            }
        }
    }

    function editarMed(med) {
        document.getElementById('form-edit').action = '/inventario/editar/' + med.id;
        document.getElementById('edit_nome').value = med.nome;
        document.getElementById('edit_lote').value = med.lote;
        document.getElementById('edit_validade').value = med.data_validade;
        document.getElementById('edit_qtd').value = med.quantidade;
        document.getElementById('edit_tarja').value = med.tarja || 'Sem Tarja';
        abrirModal('modal-edit');
    }
</script>

<%- include('layout/footer') %>
