<%- include('layout/header', { title: 'Farmácias Parceiras - RedeVita', extra_css: '/static/css/inventory.css' }) %>
<%- include('layout/nav') %>

<div class="page-wrapper">
    <div class="page-header">
        <div>
            <h2><i class="ph-duotone ph-buildings"></i> Farmácias e Unidades Parceiras</h2>
            <p class="page-subtitle">Rede conveniada de pontos de coleta, triagem e dispensação gratuita.</p>
        </div>
        <div style="display:flex; gap:10px;">
            <a href="/mapa" class="btn-secondary">
                <i class="ph-duotone ph-map-trifold"></i> Ver no Mapa
            </a>
            <button class="btn-primary" onclick="abrirModal('modal-farmacia')">
                <i class="ph-duotone ph-plus-circle"></i> Nova Unidade
            </button>
        </div>
    </div>

    <div class="table-toolbar" role="search" style="margin-top:16px;">
        <label class="table-search" for="farmacias-table-search">
            <i class="ph-duotone ph-magnifying-glass" aria-hidden="true"></i>
            <input type="search" id="farmacias-table-search"
                   data-table-search="tabela-farmacias"
                   placeholder="Buscar unidade por nome fantasia, CNPJ ou endereço..."
                   autocomplete="off">
        </label>
        <span class="table-search-hint" style="font-size:0.85rem; color:var(--text-muted);"></span>
    </div>

    <div class="table-wrapper" style="margin-top:10px;">
        <table class="styled-table" id="tabela-farmacias">
            <thead>
                <tr>
                    <th>Unidade</th>
                    <th>CNPJ</th>
                    <th>Endereço</th>
                    <th>Responsável Técnico</th>
                    <th>Telefone</th>
                    <th>Horário</th>
                </tr>
            </thead>
            <tbody>
                <% farmacias.forEach(function(f) { %>
                <tr>
                    <td>
                        <strong><%= f.nome_fantasia %></strong>
                        <br><small style="color:var(--text-muted);"><%= f.razao_social %></small>
                    </td>
                    <td><code><%= f.cnpj %></code></td>
                    <td><%= f.endereco %></td>
                    <td><%= f.responsavel %></td>
                    <td><%= f.telefone %></td>
                    <td><span class="status-pill green"><i class="ph-duotone ph-clock"></i> <%= f.horario %></span></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Nova Farmácia -->
<div id="modal-farmacia" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-header">
            <h3><i class="ph-duotone ph-buildings"></i> Cadastrar Nova Unidade</h3>
            <button type="button" class="modal-close" onclick="fecharModal('modal-farmacia')">&times;</button>
        </div>
        <form action="/farmacias" method="POST" class="modern-form" style="padding:20px;">
            <div class="form-group" style="margin-bottom:12px;">
                <label for="f_nome">Nome Fantasia *</label>
                <input type="text" id="f_nome" name="nome_fantasia" required placeholder="Ex: Farmácia Popular Centro" class="input-standard">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
                <label for="f_cnpj">CNPJ *</label>
                <input type="text" id="f_cnpj" name="cnpj" required placeholder="00.000.000/0001-00" class="input-standard">
            </div>
            <div class="form-group" style="margin-bottom:12px;">
                <label for="f_end">Endereço Completo *</label>
                <input type="text" id="f_end" name="endereco" required placeholder="Rua, número, bairro - Cidade/UF" class="input-standard">
            </div>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; margin-bottom:16px;">
                <div class="form-group">
                    <label for="f_resp">Farmacêutico Responsável</label>
                    <input type="text" id="f_resp" name="responsavel" placeholder="Nome do CRF" class="input-standard">
                </div>
                <div class="form-group">
                    <label for="f_tel">Telefone</label>
                    <input type="text" id="f_tel" name="telefone" placeholder="(15) 3333-0000" class="input-standard">
                </div>
            </div>
            <div class="modal-footer" style="display:flex; justify-content:flex-end; gap:8px;">
                <button type="button" class="btn-secondary" onclick="fecharModal('modal-farmacia')">Cancelar</button>
                <button type="submit" class="btn-primary"><i class="ph-duotone ph-floppy-disk"></i> Salvar Unidade</button>
            </div>
        </form>
    </div>
</div>

<%- include('layout/footer') %>
