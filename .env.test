# Ambiente de teste descartável. Não usar em produção.

FLASK_ENV=development

# Chave principal única (>= 32 caracteres). SESSION_SECRET e JWT_SECRET_KEY
# herdam/derivam automaticamente desta chave.
SECRET_KEY=test-secret-key-for-testing-only-32chars

# Banco de dados SQLite descartável
DATABASE_URL=sqlite:///test_redevita.db

# E-mail desativado no teste
MAIL_SERVER=
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_SUPPRESS_SEND=true
