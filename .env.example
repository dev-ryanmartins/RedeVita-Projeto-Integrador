# RedeVita - variáveis de ambiente (EXEMPLO)
# Copie para .env e preencha apenas o que for necessário.

# --- Ambiente ---------------------------------------------------------------
FLASK_ENV=production
PORT=5000

# --- Segurança --------------------------------------------------------------
# Chave principal (obrigatória em produção, >= 32 caracteres).
# SESSION_SECRET e JWT_SECRET_KEY herdam/derivam automaticamente desta chave;
# só as defina se precisar de valores próprios e distintos entre si.
SECRET_KEY=

# --- Banco de dados ---------------------------------------------------------
# Deixe DATABASE_URL vazio para usar o SQLite local de demonstração.
DATABASE_URL=
MYSQL_DATABASE=redevita
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Mapas - Mapbox (opcional) ----------------------------------------------
# Token público (pk.*) usado pelo Leaflet no mapa de saúde.
# Se vazio, o mapa usa o OpenStreetMap como fallback.
MAPBOX_ACCESS_TOKEN=

# --- Integração externa - ViaCEP (API pública de CEP) -----------------------
VIA_CEP_API_URL=https://viacep.com.br/ws/

# --- SMTP - Mailtrap Sandbox (opcional) ------------------------------------
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=RedeVita <noreply@redevita.com>
