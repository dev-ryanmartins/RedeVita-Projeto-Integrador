# Variáveis de ambiente para Docker Compose
# Copie este arquivo para .env e preencha com valores seguros
# Nunca comita o arquivo .env com valores reais

# Credenciais do banco de dados MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=redevita
MYSQL_USER=
MYSQL_PASSWORD=

# URL de conexão do banco (usado pela aplicação)
# Formato: mysql+pymysql://MYSQL_USER:MYSQL_PASSWORD@db:3306/MYSQL_DATABASE
DATABASE_URL=

# Segredos da aplicação Flask
SECRET_KEY=
SESSION_SECRET=
JWT_SECRET_KEY=
JWT_EXPIRATION=3600

# Ambiente da aplicação
FLASK_ENV=production

# Integração externa - ViaCEP (API pública de CEP)
VIA_CEP_API_URL=https://viacep.com.br/ws/

# SMTP - Mailtrap Sandbox
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=RedeVita <noreply@redevita.com>

# Tokens de APIs externas (opcionais)
ANVISA_API_TOKEN=
GOOGLE_MAPS_API_KEY=

# Instruções:
# 1. Gere senhas fortes para MYSQL_ROOT_PASSWORD, MYSQL_PASSWORD, SECRET_KEY e JWT_SECRET_KEY
# 2. Configure DATABASE_URL usando as credenciais definidas acima
# 3. Execute: docker-compose up -d
# 4. Para desenvolvimento local, a porta 3306 do MySQL está acessível apenas em localhost (127.0.0.1)
