# =============================================================================
# RedeVita - Configuração de Demonstração/Apresentação (offline-friendly)
# -----------------------------------------------------------------------------
# Como usar:
#   cp .env.demo .env        (Linux/macOS)
#   copy .env.demo .env      (Windows)
# O app carrega o .env automaticamente (backend/app/config.py -> load_dotenv).
# Sem este arquivo a aplicação TAMBÉM funciona: cai no SQLite local e nas
# chaves de fallback seguras. Este arquivo apenas deixa tudo explícito.
# =============================================================================

# --- Ambiente ---------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=true
DEMO_MODE=true

# --- Segurança --------------------------------------------------------------
# Chave principal (>= 32 caracteres, apenas para demonstração).
# SESSION_SECRET e JWT_SECRET_KEY herdam/derivam automaticamente desta chave.
# Troque por um valor aleatório em produção:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=demo-redevita-secret-key-32-chars-minimum-0001

# --- Banco de dados ---------------------------------------------------------
# Deixe DATABASE_URL vazio para usar o SQLite local de demonstração:
#   instance/redevita_demo.db  (caminho absoluto calculado em config.py)
# Para MySQL local, preencha algo como:
#   DATABASE_URL=mysql+pymysql://usuario:senha@127.0.0.1:3306/redevita
DATABASE_URL=

# --- Armazenamento local (uploads, QR Codes e PDFs 100% em disco) -----------
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# --- SMTP em modo log local (não envia e-mail real na apresentação) ---------
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_SUPPRESS_SEND=true
MAIL_DEFAULT_SENDER=RedeVita <noreply@redevita.com>

# --- Integrações externas com timeout curto (evita travar telas) ------------
# ViaCEP é consultado no navegador; ANVISA está desabilitada por padrão.
VIA_CEP_API_URL=https://viacep.com.br/ws/
VIA_CEP_TIMEOUT=4
